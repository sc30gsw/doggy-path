#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../.." && pwd)"
PORT="${DOG_PATH_PORT:-8081}"
EVIDENCE_ROOT="${DOG_PATH_EVIDENCE_ROOT:-/tmp/doggy-path-verify}"
DEV_CLIENT_ID="com.sc30gsw.doggy-path"
EXPO_GO_ID="host.exp.Exponent"

tmux_cmd() {
  if [[ -f /exec-daemon/tmux.portal.conf ]]; then
    tmux -f /exec-daemon/tmux.portal.conf "$@"
  else
    tmux "$@"
  fi
}

usage() {
  cat <<'EOF'
Usage: verify-doggy-path <command> [arg]

  launch                 Start Metro for a new run. Refuses when the port is already taken.
  restart                Restart this run's Metro. Metro runs with CI=1 and never reloads on edits.
  doctor                 Report whether this run's Metro is healthy and which native surface is attached.
  build-ios              Build and install the iOS development build on the target simulator, without a second Metro.
  open <client>          Relaunch a client on the target simulator against this run's Metro. Clients: dev-client, expo-go.
  drive <feature>        Gate one mapped feature. Features: sign-in, dog-profile, course-conditions, course-display.
  cleanup                Stop the Metro session this run started. Leaves the evidence directory in place.

Environment:
  DOG_PATH_RUN_ID          Evidence directory name. launch assigns one when unset.
  DOG_PATH_PORT            Metro port (default 8081).
  DOG_PATH_EVIDENCE_ROOT   Parent of run directories (default /tmp/doggy-path-verify).
  DOG_PATH_SIM_UDID        Simulator to target. Defaults to the first booted iPhone.
EOF
}

latest_file() {
  printf '%s/latest' "$EVIDENCE_ROOT"
}

resolve_run_id() {
  if [[ -n "${DOG_PATH_RUN_ID:-}" ]]; then
    printf '%s' "$DOG_PATH_RUN_ID"
    return
  fi
  local pointer
  pointer="$(latest_file)"
  if [[ -f "$pointer" ]]; then
    cat "$pointer"
    return
  fi
  echo "No run id. Run launch or set DOG_PATH_RUN_ID." >&2
  exit 64
}

evidence_dir() {
  printf '%s/%s' "$EVIDENCE_ROOT" "$(resolve_run_id)"
}

metro_url() {
  printf 'http://localhost:%s' "$1"
}

port_listener() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | awk 'NR>1 { print $1, $2, $9 }'
  fi
}

port_busy() {
  curl --silent --fail --max-time 2 "$(metro_url "$PORT")/status" >/dev/null 2>&1 || [[ -n "$(port_listener)" ]]
}

target_udid() {
  if [[ -n "${DOG_PATH_SIM_UDID:-}" ]]; then
    printf '%s' "$DOG_PATH_SIM_UDID"
    return
  fi
  xcrun simctl list devices booted 2>/dev/null | awk -F '[()]' '/iPhone.*\(Booted\)/ { print $2; exit }'
}

app_installed() {
  xcrun simctl get_app_container "$1" "$2" >/dev/null 2>&1
}

skill_body() {
  awk 'seen >= 2 { print } /^---$/ { seen++ }' "$1"
}

skill_copies_status() {
  local canonical="$ROOT/.cursor/skills/verify-doggy-path/SKILL.md" mirror="$ROOT/.claude/skills/verify/SKILL.md"
  if [[ ! -f "$mirror" ]]; then
    echo "mirror missing ($mirror)"
  elif cmp -s <(skill_body "$canonical") <(skill_body "$mirror"); then
    echo "in sync"
  else
    echo "DRIFT: the bodies of $canonical and $mirror differ"
  fi
}

write_surface() {
  local dest="$1" udid
  udid="$(command -v xcrun >/dev/null 2>&1 && target_udid || true)"
  if [[ -n "$udid" ]]; then
    {
      echo "ui-surface: ios-simulator"
      echo "worth-driving: yes"
      echo "target-udid: $udid"
      echo "booted:"
      xcrun simctl list devices booted | grep '(Booted)' | sed 's/^ */  /'
      if app_installed "$udid" "$DEV_CLIENT_ID"; then echo "dev-client: installed"; else echo "dev-client: missing (run build-ios)"; fi
      if app_installed "$udid" "$EXPO_GO_ID"; then echo "expo-go: installed"; else echo "expo-go: missing"; fi
    } >"$dest"
    return
  fi
  if command -v adb >/dev/null 2>&1 && adb devices 2>/dev/null | awk 'NR>1 && $2=="device" { found=1 } END { exit !found }'; then
    printf 'ui-surface: android-device\nworth-driving: yes\n' >"$dest"
    return
  fi
  cat >"$dest" <<'EOF'
ui-surface: unavailable
worth-driving: no
blocker: No booted iOS Simulator and no adb device in the "device" state. doggy-path ships as an Expo native app with no web surface. Boot a simulator (xcrun simctl boot "iPhone 17") and rerun doctor.
EOF
}

start_metro() {
  local evidence="$1" session="$2" run_id="$3"
  tmux_cmd new-session -d -s "$session" -c "$ROOT" -- bash -lc "cd '$ROOT' && CI=1 EXPO_NO_TELEMETRY=1 NODE_OPTIONS=--dns-result-order=ipv4first bunx expo start --host localhost --port '$PORT'"
  local attempt
  for attempt in $(seq 1 45); do
    if curl --silent --show-error --max-time 2 "$(metro_url "$PORT")/status" >"$evidence/metro-status.txt" 2>"$evidence/metro-status.err"; then
      tmux_cmd capture-pane -p -t "$session" >"$evidence/launch.log" || true
      echo "ready: $(metro_url "$PORT") run=${run_id}" | tee "$evidence/launch.txt"
      return
    fi
    sleep 2
  done
  tmux_cmd capture-pane -p -t "$session" >"$evidence/launch.log" || true
  echo "Metro did not answer $(metro_url "$PORT")/status" | tee "$evidence/launch.txt"
  exit 1
}

launch() {
  local run_id evidence session
  run_id="${DOG_PATH_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
  export DOG_PATH_RUN_ID="$run_id"
  evidence="$(evidence_dir)"
  mkdir -p "$evidence"

  if port_busy; then
    {
      echo "Port ${PORT} is already taken. Refusing to start a second doggy-path Metro."
      port_listener
    } | tee "$evidence/launch.txt"
    exit 1
  fi

  printf '%s\n' "$run_id" >"$(latest_file)"
  session="doggy-path-verify-${run_id}"
  printf 'session=%s\nport=%s\nroot=%s\n' "$session" "$PORT" "$ROOT" >"$evidence/state.env"
  start_metro "$evidence" "$session" "$run_id"
}

restart() {
  local evidence
  evidence="$(evidence_dir)"
  # shellcheck disable=SC1091
  source "$evidence/state.env"
  if tmux_cmd has-session -t "=$session" 2>/dev/null; then
    tmux_cmd kill-session -t "$session"
  fi
  local attempt
  for attempt in $(seq 1 10); do
    port_busy || break
    sleep 1
  done
  if port_busy; then
    {
      echo "Port ${PORT} is still taken by another process. Not restarting."
      port_listener
    } | tee "$evidence/launch.txt"
    exit 1
  fi
  start_metro "$evidence" "$session" "$(resolve_run_id)"
}

doctor() {
  local evidence
  evidence="$(evidence_dir)"
  mkdir -p "$evidence"
  # shellcheck disable=SC1091
  source "$evidence/state.env"

  {
    echo "run=$(resolve_run_id)"
    echo "port=${port}"
    if curl --silent --show-error --fail --max-time 5 "$(metro_url "$port")/status"; then
      echo
      echo "metro: up"
    else
      echo "metro: down"
    fi
    echo "listeners:"
    port_listener | sed 's/^/  /'
    if [[ -f "$ROOT/.env.local" ]] && grep -Eq '^EXPO_PUBLIC_CONVEX_URL=.+' "$ROOT/.env.local"; then
      echo "convex-url: set"
    else
      echo "convex-url: missing"
    fi
    if tmux_cmd has-session -t "=$session" 2>/dev/null; then
      echo "session: $session"
    else
      echo "session: missing"
    fi
    echo "skill-copies: $(skill_copies_status)"
  } >"$evidence/doctor.txt"
  write_surface "$evidence/surface.txt"
  cat "$evidence/surface.txt" >>"$evidence/doctor.txt"

  local bundle_status
  bundle_status="$(curl --silent --show-error --output "$evidence/ios-bundle.body" --write-out '%{http_code}' --max-time 180 "$(metro_url "$port")/node_modules/expo-router/entry.bundle?platform=ios&dev=true&minify=false" || true)"
  {
    echo "ios-bundle-http: ${bundle_status:-000}"
    if [[ -f "$evidence/ios-bundle.body" ]]; then
      echo "ios-bundle-bytes: $(wc -c <"$evidence/ios-bundle.body" | tr -d ' ')"
      if grep -q 'EXPO_PUBLIC_CONVEX_URL is not set' "$evidence/ios-bundle.body"; then
        echo "ios-bundle-error: EXPO_PUBLIC_CONVEX_URL is not set"
      fi
    fi
  } >>"$evidence/doctor.txt"
  rm -f "$evidence/ios-bundle.body"

  if ! grep -q 'metro: up' "$evidence/doctor.txt"; then
    exit 1
  fi
  if ! grep -q 'convex-url: set' "$evidence/doctor.txt"; then
    exit 1
  fi
}

build_ios() {
  local evidence udid
  evidence="$(evidence_dir)"
  udid="$(target_udid)"
  if [[ -z "$udid" ]]; then
    echo "No booted iPhone simulator. Boot one or set DOG_PATH_SIM_UDID." >&2
    exit 2
  fi
  (
    cd "$ROOT"
    LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 CI=1 EXPO_NO_TELEMETRY=1 bunx expo run:ios --device "$udid" --no-bundler
  ) >"$evidence/build-ios.log" 2>&1 || {
    tail -20 "$evidence/build-ios.log"
    echo "build-ios failed. Log: $evidence/build-ios.log" >&2
    exit 1
  }
  grep -E 'Build Succeeded|Installing|Opening' "$evidence/build-ios.log" | tail -3
}

open_client() {
  local client="$1" udid url
  udid="$(target_udid)"
  if [[ -z "$udid" ]]; then
    echo "No booted iPhone simulator. Boot one or set DOG_PATH_SIM_UDID." >&2
    exit 2
  fi
  case "$client" in
    dev-client)
      xcrun simctl terminate "$udid" "$DEV_CLIENT_ID" 2>/dev/null || true
      url="${DEV_CLIENT_ID}://expo-development-client/?url=http%3A%2F%2Flocalhost%3A${PORT}"
      ;;
    expo-go)
      xcrun simctl terminate "$udid" "$EXPO_GO_ID" 2>/dev/null || true
      xcrun simctl launch "$udid" "$EXPO_GO_ID" >/dev/null
      sleep 3
      url="exp://localhost:${PORT}"
      ;;
    *)
      echo "Unknown client: $client" >&2
      usage >&2
      exit 64
      ;;
  esac
  xcrun simctl openurl "$udid" "$url"
  echo "opened: $client $url on $udid"
}

drive() {
  local feature="$1"
  local evidence
  case "$feature" in
    sign-in | dog-profile | course-conditions | course-display) ;;
    *)
      echo "Unknown feature: $feature" >&2
      usage >&2
      exit 64
      ;;
  esac
  evidence="$(evidence_dir)"
  doctor
  {
    echo "feature: $feature"
    echo "entry: features/${feature}.md"
    cat "$evidence/surface.txt"
  } >"$evidence/drive-${feature}.txt"
  if grep -q 'worth-driving: no' "$evidence/surface.txt"; then
    echo "result: blocked" >>"$evidence/drive-${feature}.txt"
    cat "$evidence/drive-${feature}.txt"
    exit 2
  fi
  echo "result: surface-ready" >>"$evidence/drive-${feature}.txt"
  echo "This helper does not tap the screen. Follow features/${feature}.md on the target simulator and save screenshots beside this file." >>"$evidence/drive-${feature}.txt"
  exit 3
}

cleanup() {
  local evidence
  evidence="$(evidence_dir)"
  # shellcheck disable=SC1091
  source "$evidence/state.env"
  if tmux_cmd has-session -t "=$session" 2>/dev/null; then
    tmux_cmd kill-session -t "$session"
    echo "stopped-session: $session" | tee "$evidence/cleanup.txt"
  else
    echo "stopped-session: already-absent $session" | tee "$evidence/cleanup.txt"
  fi
  echo "evidence: $evidence" | tee -a "$evidence/cleanup.txt"
}

command_name="${1:-}"
shift || true
case "$command_name" in
  launch) launch ;;
  restart) restart ;;
  doctor) doctor ;;
  build-ios) build_ios ;;
  open) open_client "${1:-}" ;;
  drive) drive "${1:-}" ;;
  cleanup) cleanup ;;
  *)
    usage
    exit 64
    ;;
esac
