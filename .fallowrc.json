{
  "$schema": "./node_modules/fallow/schema.json",
  "ignorePatterns": ["convex/_generated/**", "docs/blueprint/**"],
  "ignoreDependencies": [
    "@auth/core",
    "expo-constants",
    "expo-glass-effect",
    "expo-status-bar",
    "expo-system-ui"
  ],
  "health": {
    "thresholdOverrides": [
      {
        "files": [
          "convex/domain/**",
          "convex/model/**",
          "convex/judge/**",
          "convex/courseBuilder/**",
          "convex/proposalRuns.ts",
          "src/features/course-conditions/**",
          "src/app/conditions.tsx"
        ],
        "maxCyclomatic": 20,
        "maxCognitive": 20,
        "maxCrap": 250,
        "reason": "The proposal reducer and the provider adapters are single functions, and this change has no coverage yet so CRAP tracks cyclomatic complexity."
      }
    ]
  },
  "ignoreExports": [
    {
      "file": "src/constants/theme.ts",
      "exports": ["ThemeColor", "Fonts", "Spacing", "BottomTabInset", "MaxContentWidth"]
    }
  ]
}
